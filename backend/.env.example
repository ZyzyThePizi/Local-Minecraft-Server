# Másold le .env néven. Az első indításkor a backend magától is létrehozza a .env-et egy generált jelszóval.
# Csak ez a két titok kerül ide; minden mást (gépnév, memóriakeret, címek, megosztás) a panelen állítasz be,
# és a data/settings.json-ba mentődik.

# Admin jelszó (legalább 10 karakter). Aki tudja, teljes hozzáférést kap ehhez a géphez.
# A panelen is megváltoztatható; ilyenkor minden eszköz kijelentkezik.
ADMIN_PASSWORD=

# CurseForge API kulcs: https://console.curseforge.com/ -> API Keys (ingyenes).
# Aposztrófok közé tedd, mert a kulcsban $ jelek vannak.
CURSEFORGE_API_KEY=''
