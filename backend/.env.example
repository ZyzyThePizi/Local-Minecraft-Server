# Másold le .env néven. Az első indításkor a backend magától is létrehozza a .env-et egy generált jelszóval.

# Admin jelszó a webes panelhez (legalább 10 karakter).
ADMIN_PASSWORD=

# CurseForge API kulcs: https://console.curseforge.com/ -> API Keys (ingyenes).
# Aposztrófok közé tedd, mert a kulcsban $ jelek vannak.
CURSEFORGE_API_KEY=''

# Ezen a porton figyel a backend (csak 127.0.0.1-en; kívülről a Tailscale Funnel éri el).
PORT=8765

# A gép neve a panelen (alapból a gép hostname-je).
PANEL_NAME=

# A játékosok ezt a címet kapják csatlakozáshoz (pl. a playit.gg cím). A panelről is átírható.
PUBLIC_GAME_ADDRESS=

# Ahonnan a böngésző hívhatja az API-t.
ALLOWED_ORIGINS=https://zyzythepizi.github.io,http://localhost:5173

# Ide kerülnek a szerverek, a Java futtatókörnyezetek és a beállítások (a backend mappához képest).
DATA_DIR=../data
